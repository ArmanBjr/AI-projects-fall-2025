has_color(X, Y) :- name(X), color(Y).

plane_distance(X, Y) :- name(X), distance(Y). 

% rule_2 (Color, Distance)

rule_2(Color, 8) :- Color \= silver.

rule_2(_, Y) :- Y \= 8.

% rule_3(Color, distance)
rule_3(X, 14) :- X \= white.

%rule_3(X5, Y5)
%rule_3(X4, Y4)
rule_3(white, Y) :- Y \= 14.

% rule_4 (Color, Color, Distance, Distance)
rule_4(white, black, Y1, Y2) :- Y1 is Y2 + 6.
rule_4(X, _, _, _) :- X \= white.
rule_4(_, X, _, _) :- X \= black.


% rule_5 (Color, Distance)
rule_5(Color, 5) :- Color = pink.

rule_5(Y, X) :- X \= 5, Y \= pink.

% rule_6(Color, distance, distance)

rule_6(pink, Y1, Y2) :- Y1 > Y2.

rule_6(X, _, _) :- X \= pink. 

% rule_7(Color, Color)
rule_7(Y1, Y2) :- Y1 = green ; Y2 = green.


